{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/certification-stage-evidence.v1.json",
  "title": "TokenSaver Plugin Certification Stage Evidence v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "requirement",
    "subject",
    "rule",
    "producer",
    "startedAtUnix",
    "completedAtUnix",
    "ok",
    "inputs",
    "outputs",
    "detail",
    "remediation"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requirement": {
      "enum": [
        "manifest-validation",
        "tspp-lifecycle",
        "safety-contract",
        "public-corpus-benchmark",
        "protocol-fuzzing",
        "reproducible-build",
        "signed-artifact",
        "sbom",
        "license-provenance",
        "admin-policy-metadata"
      ]
    },
    "subject": { "$ref": "#/$defs/subject" },
    "rule": { "$ref": "#/$defs/token" },
    "producer": {
      "type": "object",
      "required": ["id", "version", "environmentDigest"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "environmentDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "startedAtUnix": { "type": "integer", "minimum": 0 },
    "completedAtUnix": { "type": "integer", "minimum": 0 },
    "ok": { "type": "boolean" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/reference" }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/reference" }
    },
    "detail": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "additionalProperties": false,
  "$defs": {
    "subject": {
      "type": "object",
      "required": [
        "pluginId",
        "version",
        "platform",
        "apiVersion",
        "artifactDigest",
        "packageDigest",
        "releaseId"
      ],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "apiVersion": { "const": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "packageDigest": { "$ref": "#/$defs/digest" },
        "releaseId": { "$ref": "#/$defs/releaseId" }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["name", "digest"],
      "properties": {
        "name": { "$ref": "#/$defs/token" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^tsr1_[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/runtime-host-request.v1.json",
  "title": "TokenSaver trusted runtime host request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "attemptId",
    "pluginId",
    "releaseId",
    "platform",
    "packageDigest",
    "artifactDigest",
    "executablePath",
    "releasePath",
    "workPath",
    "arguments",
    "input",
    "deadlineMilliseconds",
    "maximumMemoryBytes",
    "maximumStdoutBytes",
    "maximumStderrBytes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "enum": ["execute", "deprovision"] },
    "attemptId": { "type": "string", "pattern": "^tsa1_[0-9a-f]{32}$" },
    "pluginId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
    },
    "releaseId": { "type": "string", "pattern": "^tsr1_[0-9a-f]{64}$" },
    "platform": {
      "enum": [
        "windows-x64",
        "windows-arm64",
        "linux-x64",
        "linux-arm64",
        "darwin-x64",
        "darwin-arm64"
      ]
    },
    "packageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "executablePath": { "type": "string", "minLength": 1 },
    "releasePath": { "type": "string", "minLength": 1 },
    "workPath": { "type": "string", "minLength": 1 },
    "arguments": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "input": { "type": "string", "minLength": 1, "contentEncoding": "base64" },
    "deadlineMilliseconds": { "type": "integer", "minimum": 1, "maximum": 1250 },
    "maximumMemoryBytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
    "maximumStdoutBytes": { "type": "integer", "minimum": 1, "maximum": 25165824 },
    "maximumStderrBytes": { "type": "integer", "minimum": 1, "maximum": 65536 }
  }
}

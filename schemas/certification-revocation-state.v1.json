{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/certification-revocation-state.v1.json",
  "title": "TokenSaver Plugin Certification Revocation State v1",
  "type": "object",
  "required": ["schemaVersion", "issuerId", "sequence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "issuerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "sequence": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}

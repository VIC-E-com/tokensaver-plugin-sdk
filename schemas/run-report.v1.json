{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/run-report.v1.json",
  "title": "TokenSaver Plugin Run Report v1",
  "type": "object",
  "required": [
    "schemaVersion", "ok", "pluginId", "version", "platform", "releaseId",
    "artifactDigest", "activationAttemptId", "action", "inputBytes", "outputBytes",
    "savedBytes", "savingsPercent", "output", "durationMs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "const": true },
    "pluginId": { "type": "string" },
    "version": { "type": "string" },
    "platform": { "type": "string" },
    "releaseId": { "$ref": "#/$defs/releaseId" },
    "artifactDigest": { "$ref": "#/$defs/digest" },
    "activationAttemptId": { "$ref": "#/$defs/activationAttemptId" },
    "action": { "enum": ["pass", "optimize"] },
    "inputBytes": { "type": "integer", "minimum": 0 },
    "outputBytes": { "type": "integer", "minimum": 0 },
    "savedBytes": { "type": "integer", "minimum": 0 },
    "savingsPercent": { "type": "number", "minimum": 0, "maximum": 100 },
    "output": { "type": "string" },
    "durationMs": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "releaseId": { "type": "string", "pattern": "^tsr1_[0-9a-f]{64}$" },
    "activationAttemptId": { "type": "string", "pattern": "^tsa1_[0-9a-f]{32}$" }
  }
}

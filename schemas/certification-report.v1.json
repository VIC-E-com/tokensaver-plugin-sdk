{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/certification-report.v1.json",
  "title": "TokenSaver Plugin Certification Report v1",
  "type": "object",
  "required": ["schemaVersion", "ok", "certificationLevel", "subject", "authority", "checks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "type": "boolean" },
    "certificationLevel": { "type": "integer", "enum": [1, 2, 3] },
    "subject": {
      "type": "object",
      "required": ["pluginId", "version", "platform", "apiVersion", "artifactDigest", "packageDigest", "releaseId"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "apiVersion": { "const": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "packageDigest": { "$ref": "#/$defs/digest" },
        "releaseId": { "$ref": "#/$defs/releaseId" }
      },
      "additionalProperties": true
    },
    "authority": {
      "type": "object",
      "required": ["issuerId", "policyId", "policyVersion", "revocationId"],
      "properties": {
        "issuerId": { "$ref": "#/$defs/token" },
        "policyId": { "const": "com.tokensaver.plugin-certification" },
        "policyVersion": { "const": 1 },
        "revocationId": { "$ref": "#/$defs/token" }
      },
      "additionalProperties": true
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["requirement", "ok", "rule", "evidenceDigest", "detail", "remediation"],
        "properties": {
          "requirement": {
            "enum": [
              "manifest-validation", "tspp-lifecycle", "safety-contract",
              "public-corpus-benchmark", "protocol-fuzzing", "reproducible-build",
              "signed-artifact", "sbom", "license-provenance", "admin-policy-metadata"
            ]
          },
          "ok": { "type": "boolean" },
          "rule": { "$ref": "#/$defs/token" },
          "evidenceDigest": { "$ref": "#/$defs/digest" },
          "detail": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "remediation": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^tsr1_[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/certification-fuzz-corpus.v1.json",
  "title": "TokenSaver Plugin Certification Protocol Fuzz Corpus v1",
  "type": "object",
  "required": ["schemaVersion", "corpusId", "protocol", "repetitions", "limits", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "$ref": "#/$defs/token" },
    "protocol": { "const": "TSPP/1" },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "limits": {
      "type": "object",
      "required": [
        "maximumExecutionMilliseconds",
        "maximumMemoryBytes",
        "maximumStdoutBytes",
        "maximumStderrBytes",
        "requiredSanitizers"
      ],
      "properties": {
        "maximumExecutionMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "maximumMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "maximumStdoutBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "maximumStderrBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "requiredSanitizers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["address", "leak", "memory", "thread", "undefined"]
          }
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "required": ["id", "class", "inputBase64"],
        "properties": {
          "id": { "$ref": "#/$defs/token" },
          "class": { "enum": ["valid", "malformed"] },
          "inputBase64": { "type": "string", "maxLength": 22369624 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}

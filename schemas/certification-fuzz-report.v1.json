{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/certification-fuzz-report.v1.json",
  "title": "TokenSaver Plugin Certification Protocol Fuzz Report v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "subject",
    "protocol",
    "engine",
    "corpusDigest",
    "startedAtUnix",
    "completedAtUnix",
    "totalExecutions",
    "validInputs",
    "validInputsAccepted",
    "malformedInputs",
    "malformedInputsRejected",
    "coverageBasisPoints",
    "crashes",
    "hangs",
    "sanitizerFailures",
    "memoryLimitViolations",
    "stdoutProtocolViolations",
    "stderrLimitViolations",
    "deadlineViolations",
    "unreapedProcesses",
    "durationMilliseconds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "subject": { "$ref": "#/$defs/subject" },
    "protocol": { "const": "TSPP/1" },
    "engine": {
      "type": "object",
      "required": ["id", "version", "activeSanitizers"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "activeSanitizers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["address", "leak", "memory", "thread", "undefined"]
          }
        }
      },
      "additionalProperties": false
    },
    "corpusDigest": { "$ref": "#/$defs/digest" },
    "startedAtUnix": { "type": "integer", "minimum": 1 },
    "completedAtUnix": { "type": "integer", "minimum": 1 },
    "totalExecutions": { "$ref": "#/$defs/counter" },
    "validInputs": { "$ref": "#/$defs/counter" },
    "validInputsAccepted": { "$ref": "#/$defs/counter" },
    "malformedInputs": { "$ref": "#/$defs/counter" },
    "malformedInputsRejected": { "$ref": "#/$defs/counter" },
    "coverageBasisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "crashes": { "$ref": "#/$defs/counter" },
    "hangs": { "$ref": "#/$defs/counter" },
    "sanitizerFailures": { "$ref": "#/$defs/counter" },
    "memoryLimitViolations": { "$ref": "#/$defs/counter" },
    "stdoutProtocolViolations": { "$ref": "#/$defs/counter" },
    "stderrLimitViolations": { "$ref": "#/$defs/counter" },
    "deadlineViolations": { "$ref": "#/$defs/counter" },
    "unreapedProcesses": { "$ref": "#/$defs/counter" },
    "durationMilliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800000
    }
  },
  "additionalProperties": false,
  "$defs": {
    "subject": {
      "type": "object",
      "required": [
        "pluginId",
        "version",
        "platform",
        "apiVersion",
        "artifactDigest",
        "packageDigest",
        "releaseId"
      ],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "platform": { "type": "string", "minLength": 1, "maxLength": 64 },
        "apiVersion": { "const": 1 },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "packageDigest": { "$ref": "#/$defs/digest" },
        "releaseId": {
          "type": "string",
          "pattern": "^tsr1_[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}

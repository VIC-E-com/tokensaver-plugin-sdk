{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/catalog-report.v1.json",
  "title": "TokenSaver Plugin Catalog Assembly Report v1",
  "type": "object",
  "required": [
    "schemaVersion", "ok", "pluginId", "version", "catalog",
    "catalogSizeBytes", "catalogDigest", "packageCount", "platforms"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "const": true },
    "pluginId": { "type": "string" },
    "version": { "type": "string" },
    "catalog": { "type": "string" },
    "catalogSizeBytes": { "type": "integer", "minimum": 1 },
    "catalogDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "packageCount": { "type": "integer", "minimum": 1, "maximum": 32 },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}

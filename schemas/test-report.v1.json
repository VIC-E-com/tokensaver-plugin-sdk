{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/test-report.v1.json",
  "title": "TokenSaver Plugin Golden Test Report v1",
  "type": "object",
  "required": [
    "schemaVersion", "ok", "pluginId", "version", "platform", "releaseId",
    "artifactDigest", "fixtureDirectory", "passed", "failed", "cases", "durationMs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "ok": { "type": "boolean" },
    "pluginId": { "type": "string" },
    "version": { "type": "string" },
    "platform": { "type": "string" },
    "releaseId": { "$ref": "#/$defs/releaseId" },
    "artifactDigest": { "$ref": "#/$defs/digest" },
    "fixtureDirectory": { "type": "string" },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ok", "name", "path", "expectedAction", "activationAttemptId", "message", "durationMs"
        ],
        "properties": {
          "ok": { "type": "boolean" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "expectedAction": { "enum": ["pass", "optimize"] },
          "actualAction": { "enum": ["pass", "optimize", null] },
          "activationAttemptId": { "$ref": "#/$defs/activationAttemptId" },
          "message": { "type": "string" },
          "durationMs": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": true
      }
    },
    "durationMs": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "releaseId": { "type": "string", "pattern": "^tsr1_[0-9a-f]{64}$" },
    "activationAttemptId": { "type": "string", "pattern": "^tsa1_[0-9a-f]{32}$" }
  }
}

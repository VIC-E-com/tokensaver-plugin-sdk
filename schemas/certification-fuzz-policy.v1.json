{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdk.tokensaver.app/schemas/certification-fuzz-policy.v1.json",
  "title": "TokenSaver Plugin Certification Protocol Fuzz Policy v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "policyId",
    "protocol",
    "corpusId",
    "corpusDigest",
    "minimumExecutions",
    "minimumValidInputs",
    "minimumMalformedInputs",
    "minimumCoverageBasisPoints",
    "maximumDurationMilliseconds"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": { "$ref": "#/$defs/token" },
    "protocol": { "const": "TSPP/1" },
    "corpusId": { "$ref": "#/$defs/token" },
    "corpusDigest": { "$ref": "#/$defs/digest" },
    "minimumExecutions": { "$ref": "#/$defs/executionCount" },
    "minimumValidInputs": { "$ref": "#/$defs/executionCount" },
    "minimumMalformedInputs": { "$ref": "#/$defs/executionCount" },
    "minimumCoverageBasisPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "maximumDurationMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800000
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}

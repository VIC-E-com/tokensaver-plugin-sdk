{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tokensaver.app/plugin-sdk/certification-license-policy.v1.json",
  "title": "TokenSaver certification license policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyId",
    "allowedSpdxIds",
    "deniedSpdxIds",
    "maximumComponents",
    "requireAllComponentsLicensed",
    "requireComponentProvenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "allowedSpdxIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/spdxId" }
    },
    "deniedSpdxIds": {
      "type": "array",
      "maxItems": 512,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/spdxId" }
    },
    "maximumComponents": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "requireAllComponentsLicensed": { "const": true },
    "requireComponentProvenance": { "const": true }
  },
  "$defs": {
    "spdxId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9.+_-]+$"
    }
  }
}
